# ─── Showcase slice (docs/mvp/12 §7) ─────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Required. Login password for the demo (/login).
DEMO_PASSWORD=
# Required. 32+ random characters; signs the session cookie (HMAC-SHA256).
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Postgres/Supabase connection string. Empty = PGlite in .data/pglite (gitignored).
DATABASE_URL=
# Optional explicit direct URL for migration session locks (non-Neon poolers).
# Neon -pooler hosts are converted to their direct endpoint by the migration command.
MIGRATION_DATABASE_URL=

# Cloud demo: set APP_URL to the HTTPS Render URL after creating the service.
APP_URL=
# 1 enables test-inbox previews and delivery ONLY to DEMO_RECIPIENT_EMAIL.
# 0/empty preserves normal outreach rules and the legacy Copy / Mark as sent flow.
DEMO_EMAIL_ENABLED=0
DEMO_RECIPIENT_EMAIL=
RESEND_API_KEY=
# Optional live contact discovery + email validation. Server-only; never NEXT_PUBLIC_.
# Hunter's test-api-key is rejected because it returns dummy data.
HUNTER_API_KEY=
# Local safety cap on actual Hunter HTTP requests, not a promise about provider credits.
HUNTER_DAILY_REQUEST_LIMIT=5
# No domain purchase needed if the test inbox is the email associated with the Resend account.
DEMO_EMAIL_FROM="Demo <onboarding@resend.dev>"
# Opt-in Node worker: sends only explicitly approved campaigns to deeptendukuri@gmail.com.
# Off by default. A sleeping free host does not run timers; use an authenticated external trigger.
MVP_OUTREACH_WORKER=off
# 32+ random characters. Server-only bearer token for POST /api/mvp/outreach/worker.
OUTREACH_WORKER_SECRET=
# New, separately opt-in research-to-meeting funnel. Default paused in the database too.
# Managed public receiving domain, e.g. abc123.resend.app (no domain purchase needed).
RESEND_RECEIVING_DOMAIN=
# Optional targeted web research. Search snippets never qualify as verified evidence.
TAVILY_API_KEY=
# on = local Node worker; external = authenticated /api/mvp/outreach/worker trigger only.
MVP_FUNNEL_WORKER=off
# Google Cloud Web Application OAuth client; connect the approved demo account in Outreach.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI must exactly match APP_URL + /api/mvp/automation/calendar/callback.
SALES_TIMEZONE=Asia/Kolkata
MEETING_DURATION_MINUTES=30
SALES_START_HOUR=10
SALES_END_HOUR=18
# Cloud migration: pnpm db:migrate (requires DATABASE_URL, applies only src/mvp/db/migrations).
# Render start: pnpm start:cloud (migrates automatically, then binds 0.0.0.0:$PORT).

# Optional. 1 = use offline fixtures only (no network); fixture leads show a "Sample data" badge.
MVP_OFFLINE=

# Optional. Enables live AI (model A). Empty = demo mode ("AI simulated", rules-based mock).
GROQ_API_KEY=
# Optional. Model B for two-model agreement (Cloudflare Workers AI).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Daily token budgets per provider (UTC day, 10% headroom kept).
LLM_DAILY_TOKEN_BUDGET__GROQ=180000
LLM_DAILY_TOKEN_BUDGET__CLOUDFLARE=300000

# Optional model overrides per role (defaults in src/mvp/llm/index.ts, docs/mvp/06 §2).
# LLM_MODEL__TRIAGE=
# LLM_MODEL__EXTRACT_A=
# LLM_MODEL__EXTRACT_B=
# LLM_MODEL__DRAFT=
# LLM_MODEL__JUDGE=

# Optional. Comma-separated RSS feed URLs; empty = defaults in code.
RSS_FEEDS=

# ─── Legacy prototype (/legacy) ──────────────────────────────────────────────
NEXT_PUBLIC_DATABASE_URL=
NEXT_PUBLIC_DATABASE_PUBLIC_KEY=
DATABASE_SERVICE_KEY=
SEARCH_PROVIDER_API_KEY=
CONTENT_PROVIDER_API_KEY=
OPENAI_API_KEY=
TRADE_DATA_API_KEY=

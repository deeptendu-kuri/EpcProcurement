# ─── Showcase slice (docs/mvp/12 §7) ─────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Required. Login password for the demo (/login).
DEMO_PASSWORD=
# Required. 32+ random characters; signs the session cookie (HMAC-SHA256).
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Postgres/Supabase connection string. Empty = PGlite in .data/pglite (gitignored).
DATABASE_URL=

# Optional. 1 = use offline fixtures only (no network); fixture leads show a "Sample data" badge.
MVP_OFFLINE=

# Optional. Enables live AI (model A). Empty = demo mode ("AI simulated", rules-based mock).
GROQ_API_KEY=
# Optional. Model B for two-model agreement (Cloudflare Workers AI).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Daily token budgets per provider (UTC day, 10% headroom kept).
LLM_DAILY_TOKEN_BUDGET__GROQ=180000
LLM_DAILY_TOKEN_BUDGET__CLOUDFLARE=300000

# Optional model overrides per role (defaults in src/mvp/llm/index.ts, docs/mvp/06 §2).
# LLM_MODEL__TRIAGE=
# LLM_MODEL__EXTRACT_A=
# LLM_MODEL__EXTRACT_B=
# LLM_MODEL__DRAFT=
# LLM_MODEL__JUDGE=

# Optional. Comma-separated RSS feed URLs; empty = defaults in code.
RSS_FEEDS=

# ─── Legacy prototype (/legacy) ──────────────────────────────────────────────
NEXT_PUBLIC_DATABASE_URL=
NEXT_PUBLIC_DATABASE_PUBLIC_KEY=
DATABASE_SERVICE_KEY=
SEARCH_PROVIDER_API_KEY=
CONTENT_PROVIDER_API_KEY=
OPENAI_API_KEY=
TRADE_DATA_API_KEY=
